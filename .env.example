# ---------------------------------------------------------------
# Collector
# ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8787

# Fonte dos dados (padrões oficiais do TSE)
TSE_BASE_URL=https://resultados.tse.jus.br/
TSE_AMBIENTE=oficial
# Verifica a assinatura digital (Ed25519) dos arquivos .jws do TSE.
TSE_VERIFY_JWS=true
TSE_TIMEOUT_MS=15000

# Cadência do polling (ms)
POLL_ACTIVE_MS=15000
POLL_IDLE_MS=60000
POLL_CONCURRENCY=8
POLL_RUN_ON_START=true

# Origens permitidas no CORS (para o web consumir a API).
# Em produção, troque pelo domínio do site, ex.: https://apuracao.exemplo.com
CORS_ORIGIN=*

# Opcionais (o collector funciona sem eles, com cache em memória):
# REDIS_URL=redis://127.0.0.1:6379
# DATABASE_URL=postgres://user:senha@127.0.0.1:5432/apuracao

# ---------------------------------------------------------------
# Web (Next.js) — NEXT_PUBLIC_* é embutido no BUILD
# ---------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8787
