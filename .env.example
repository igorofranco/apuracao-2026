# ---------------------------------------------------------------
# Collector
# ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
# pretty (dev) | json (produção, melhor para pm2/agregação)
LOG_FORMAT=json

# Fonte dos dados (padrões oficiais do TSE)
TSE_BASE_URL=https://resultados.tse.jus.br/
TSE_AMBIENTE=oficial
TSE_CICLO=ele2026
# Resolve os códigos de eleição a partir do config do TSE (cobre 2º turno).
TSE_ELEICOES_AUTO=true
# Overrides opcionais (se quiser fixar):
# TSE_ELEICAO_FEDERAL=6257
# TSE_ELEICAO_ESTADUAL=6259

# Verifica a assinatura digital (Ed25519) dos arquivos .jws do TSE.
TSE_VERIFY_JWS=true
TSE_TIMEOUT_MS=15000

# Cadência do polling (ms)
POLL_ACTIVE_MS=15000
POLL_IDLE_MS=60000
POLL_MAX_BACKOFF_MS=300000
POLL_CONCURRENCY=8
POLL_RETRIES=2
POLL_RUN_ON_START=true

# Origens permitidas no CORS (lista separada por vírgula).
# Com same-origin via nginx, pode deixar só o domínio do site.
CORS_ORIGIN=http://localhost:3000

# Proteção contra abuso
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
MAX_SSE_PER_IP=10

# Snapshots em memória por corrida (fallback; histórico durável usa DATABASE_URL)
SNAPSHOT_LIMIT=500
# Retenção do histórico no Postgres (dias) e limite de pontos por consulta
HISTORY_RETENTION_DAYS=7
HISTORY_MAX_POINTS=5000
HISTORY_PRUNE_INTERVAL_MS=21600000

# Persistência e escala (opcionais, mas recomendados se você já os tem):
# - DATABASE_URL: histórico durável (sobrevive a restart) + consulta por período.
# - REDIS_URL: fan-out de SSE entre instâncias (só útil com +1 collector).
# DATABASE_URL=postgres://user:senha@127.0.0.1:5432/apuracao
# REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------
# Web (Next.js)
# ---------------------------------------------------------------
WEB_PORT=3000
# Produção (same-origin): deixe VAZIO. O navegador usa /api relativo.
NEXT_PUBLIC_API_URL=
# Alvo do proxy server-side do Next para /api/* (BUILD-time). Padrão: collector local.
# Basta mudar se o collector não estiver em 127.0.0.1:8787 no momento do build.
API_PROXY_TARGET=http://127.0.0.1:8787
